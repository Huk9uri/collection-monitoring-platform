# 웹 애플리케이션이 호출할 읽기 전용 모니터링 API 주소
VITE_MONITORING_API_URL=http://localhost:8000
VITE_MONITORING_API_TIMEOUT_MS=40000

# API가 허용할 웹 애플리케이션 Origin(여러 값은 쉼표로 구분)
MONITORING_CORS_ORIGINS=http://localhost:5173

# DB 로그인/연결, SQL statement, 수집기 공통 응답 제한 시간(초, 모두 양수)
MONITORING_DB_CONNECT_TIMEOUT_SECONDS=5
MONITORING_DB_QUERY_TIMEOUT_SECONDS=30
MONITORING_SOURCE_TIMEOUT_SECONDS=35

# 아래 정책은 실제 scheduler와 운영 SLA를 확인한 값만 설정하세요.
# 미설정 항목은 저장된 실행 상태를 그대로 표시하며 일정을 추측하지 않습니다.
# MONITORING_FCDAUM_SCHEDULE_TIMEZONE=Asia/Seoul
# MONITORING_FCDAUM_DAILY_SCHEDULED_TIME=<ACTUAL_HH:MM>
# MONITORING_FCDAUM_MAX_DURATION_MINUTES=<POSITIVE_MINUTES>
# MONITORING_FCDAUM_FRESHNESS_SLA_MINUTES=reports=<MINUTES>,issues=<MINUTES>,missions=<MINUTES>
# MONITORING_HMR_SCHEDULE_TIMEZONE=Asia/Seoul
# MONITORING_HMR_DAILY_SCHEDULED_TIME=<ACTUAL_HH:MM>
# MONITORING_HMR_MAX_DURATION_MINUTES=<POSITIVE_MINUTES>
# MONITORING_HMR_FRESHNESS_SLA_MINUTES=naver=<MINUTES>,godomall=<MINUTES>,coupang=<MINUTES>,lotteon=<MINUTES>,elevenst=<MINUTES>,ssg=<MINUTES>,cj_onstyle=<MINUTES>,toss=<MINUTES>
MONITORING_SMARTPLACE_SCHEDULE_TIMEZONE=Asia/Seoul
MONITORING_SMARTPLACE_DAILY_SCHEDULED_TIME=04:00
MONITORING_SMARTPLACE_START_GRACE_MINUTES=15
MONITORING_SMARTPLACE_MAX_DURATION_MINUTES=180
# 예약 시각부터 이 시간 안에 시작된 실행만 예약 회차로 귀속합니다.
# 기본 60분은 일반적인 스케줄러 지연을 허용하면서 00:30 등 별도 수동 실행을 제외합니다.
# 시작 유예시간 이상, 일일 주기와 겹치지 않는 1440분 미만이어야 합니다.
MONITORING_SMARTPLACE_SCHEDULE_ATTRIBUTION_WINDOW_MINUTES=60
MONITORING_SMARTPLACE_EXPECTED_SCOPES=hanchon:한촌설렁탕,yuksoodang:육수당

# 아래 값은 형식 예시이며 실제 서버, DB, 계정, 비밀번호가 아닙니다.
# 데이터 소스별 SELECT 전용 계정을 발급하고 비밀 저장소에서 실제 값을 주입하세요.
MONITORING_FCDAUM_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=<FCDAUM_SQLSERVER>;Database=<FCDAUM_DATABASE>;UID=<FCDAUM_READONLY_USER>;PWD=<SECRET_FROM_SECRET_STORE>;Encrypt=yes;TrustServerCertificate=no;ApplicationIntent=ReadOnly
MONITORING_HMR_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=<HMR_SQLSERVER>;Database=<HMR_DATABASE>;UID=<HMR_READONLY_USER>;PWD=<SECRET_FROM_SECRET_STORE>;Encrypt=yes;TrustServerCertificate=no;ApplicationIntent=ReadOnly
MONITORING_SMARTPLACE_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=monitoring-db.example.internal;Database=naverDB;UID=monitoring_reader;PWD=secret-from-secure-store;Encrypt=yes;TrustServerCertificate=no;ApplicationIntent=ReadOnly
MONITORING_NAVER_STORE_HOURS_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=example;Database=naverDB;UID=monitor_store_hours;PWD=replace-me;ApplicationIntent=ReadOnly

# 네이버 매장 영업시간: 조회 연결만으로 등록 가능. 아래 일정 값은 실제 예약 확인 후 모두 함께 설정.
# 요일은 월요일=0 ~ 일요일=6. 값은 운영 설정에서 확인하며 기본 일정은 없음.
# MONITORING_NAVER_STORE_HOURS_SCHEDULE_TIMEZONE=
# MONITORING_NAVER_STORE_HOURS_WEEKLY_SCHEDULED_DAY=
# MONITORING_NAVER_STORE_HOURS_WEEKLY_SCHEDULED_TIME=
# MONITORING_NAVER_STORE_HOURS_START_GRACE_MINUTES=
# MONITORING_NAVER_STORE_HOURS_MAX_DURATION_MINUTES=
# MONITORING_NAVER_STORE_HOURS_SCHEDULE_ATTRIBUTION_WINDOW_MINUTES=

# 대시보드 수집기 정보 관련 설정을 위한 관리자 로그인 정보
MONITORING_ADMIN_USERNAME=admin
MONITORING_ADMIN_PASSWORD=

# 인증·기준 일정용 별도 제어 DB (수집기 연결과 분리, 실제 값은 .env에만 저장)
# MONITORING_CONTROL_CONNECTION_STRING=
# 운영 시 HTTPS 웹 Origin과 정확한 API Host를 함께 설정
MONITORING_PRODUCTION=false
# MONITORING_ALLOWED_HOSTS=monitoring.example.internal
